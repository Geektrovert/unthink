  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/Geektrovert/unthink.git"
  },
  "type": "module",
  "scripts": {
    "setup": "convex dev --once --configure new --dev-deployment cloud",
    "dev": "vite --host localhost --port 5173 --strictPort",
    "dev:convex": "convex dev",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --report-unused-disable-directives .",
    "lint:fix": "oxlint --report-unused-disable-directives --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test && bun run build"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@convex-dev/better-auth": "0.12.5",
    "@tanstack/react-router": "1.170.27",
    "better-auth": "1.6.27",
    "convex": "1.43.0",
    "posthog-js": "1.416.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@babel/core": "8.0.1",
    "@edge-runtime/vm": "5.0.0",
    "@oxlint/plugins": "1.78.0",
    "@rolldown/plugin-babel": "0.2.3",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "babel-plugin-react-compiler": "1.0.0",
    "convex-test": "0.0.55",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  },
  "engines": {
    "bun": ">=1.3.13"
  },
  "packageManager": "bun@1.3.13"
}
