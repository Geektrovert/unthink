CONVEX_DEPLOYMENT=dev:<id> # team: name, project: name
VITE_CONVEX_URL=https://<deployment-id>.convex.cloud
VITE_CONVEX_SITE_URL=https://<deployment-id>.convex.site
VITE_POSTHOG_KEY=<ph_project_token>
VITE_POSTHOG_HOST=https://<region>.i.posthog.com

# Vercel build-only source-map upload. POSTHOG_API_KEY is a narrowly scoped
# personal key and must never use the VITE_ prefix.
POSTHOG_API_KEY=<ph_personal_api_key>
POSTHOG_PROJECT_ID=<posthog_project_id>
POSTHOG_HOST=https://<region>.i.posthog.com

# VITE_VERCEL_ENV, VITE_VERCEL_GIT_COMMIT_SHA, VERCEL, and
# VERCEL_GIT_COMMIT_SHA are supplied by Vercel's system environment.
